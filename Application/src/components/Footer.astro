---
import { footerNav, researchTopics, site, social } from '../data/site';

const year = new Date().getFullYear();

// Inline paths keep the footer icon set self-contained — no icon font, no CDN.
const icons: Record<string, string> = {
	facebook:
		'M9.1 21.5v-8.4H6.3V9.7h2.8V7.3c0-2.8 1.7-4.3 4.2-4.3 1.2 0 2.2.1 2.5.1v2.9h-1.7c-1.4 0-1.6.6-1.6 1.6v2.1h3.2l-.4 3.4h-2.8v8.4H9.1z',
	linkedin:
		'M6.9 8.6H3.5v11h3.4v-11zM5.2 3.2a2 2 0 100 4 2 2 0 000-4zM20.5 13.5c0-3.2-1.7-4.7-4-4.7-1.8 0-2.7 1-3.1 1.7V8.6H10v11h3.4v-6.1c0-1.6.3-3.2 2.3-3.2s2 1.8 2 3.3v6h3.4v-6.1z',
	twitter:
		'M22 5.9c-.7.3-1.5.6-2.4.7.9-.5 1.5-1.3 1.8-2.3-.8.5-1.7.8-2.6 1a4.1 4.1 0 00-7 3.7A11.6 11.6 0 013.4 4.6a4.1 4.1 0 001.3 5.5c-.7 0-1.3-.2-1.9-.5a4.1 4.1 0 003.3 4c-.6.2-1.2.2-1.8.1a4.1 4.1 0 003.8 2.9A8.2 8.2 0 012 18.3a11.6 11.6 0 006.3 1.8c7.5 0 11.7-6.3 11.7-11.7v-.5c.8-.6 1.5-1.3 2-2z',
};
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<a href="/" aria-label={`${site.name} home`}>
				<img src="/images/logo-mark.png" alt={site.name} width="180" height="78" loading="lazy" />
			</a>
			<ul class="socials">
				{
					social.map((item) => (
						<li>
							<a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
									<path d={icons[item.icon]} fill="currentColor" />
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<nav class="footer-col" aria-label="Footer">
			<h3>Menu</h3>
			<ul>
				{footerNav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
			</ul>
		</nav>

		<div class="footer-col">
			<h3>Contact info</h3>
			<p class="footer-label">Email</p>
			<p><a href={`mailto:${site.email}`}>{site.email}</a></p>
			<p class="footer-label">Location</p>
			<p>Reach out to us at:<br />{site.address}</p>
		</div>

		<nav class="footer-col" aria-label="Research topics">
			<h3>Research</h3>
			<ul>
				{researchTopics.map((topic) => <li><a href={`/${topic.slug}`}>{topic.label}</a></li>)}
			</ul>
		</nav>
	</div>

	<div class="container footer-bottom">
		<p>Copyright &copy; {year}, {site.name}. All Rights Reserved</p>
	</div>
</footer>

<style>
	.site-footer {
		background: #1c1c1c;
		color: rgba(255, 255, 255, 0.72);
		padding-top: 4rem;
		font-size: 0.9375rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr 1.2fr 1.3fr;
		gap: 2.5rem;
		padding-bottom: 3rem;
	}

	.footer-brand img {
		display: block;
		width: 180px;
		height: auto;
		margin-bottom: 1.25rem;
	}

	.socials {
		display: flex;
		gap: 0.6rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.socials a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 50%;
		color: #fff;
		transition: background-color 0.18s ease, border-color 0.18s ease;
	}

	.socials a:hover {
		background: var(--color-accent);
		border-color: var(--color-accent);
		text-decoration: none;
	}

	.footer-col h3 {
		font-size: 1rem;
		color: #fff;
		margin-bottom: 1.1rem;
	}

	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-col li {
		margin-bottom: 0.6rem;
	}

	.footer-col a {
		color: rgba(255, 255, 255, 0.72);
	}

	.footer-col a:hover {
		color: #fff;
	}

	.footer-col p {
		margin-bottom: 0.5rem;
	}

	.footer-label {
		font-family: var(--font-heading);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #fff;
		margin-top: 1.25rem;
		margin-bottom: 0.25rem;
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding-block: 1.5rem;
		text-align: center;
		font-size: 0.875rem;
	}

	.footer-bottom p {
		margin: 0;
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 2rem;
		}
	}

	@media (max-width: 560px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
