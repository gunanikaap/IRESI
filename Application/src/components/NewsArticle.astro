---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'news'>;
}

const { post } = Astro.props;
const { title, date, author, image, gallery } = post.data;
const { Content } = await render(post);

const dateFormat = new Intl.DateTimeFormat('en-IE', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
---

<article class="section">
	<div class="container news">
		<p class="back"><a href="/news-events">&larr; News &amp; Events</a></p>
		<h1>{title}</h1>
		<p class="meta">
			{author && <span>{author}</span>}
			<time datetime={date.toISOString()}>{dateFormat.format(date)}</time>
		</p>

		{image && <img class="hero-image" src={image} alt="" loading="eager" />}

		<div class="prose">
			<Content />
		</div>

		{
			gallery.length > 0 && (
				<ul class="gallery">
					{gallery.map((src) => (
						<li>
							<img src={src} alt="" loading="lazy" />
						</li>
					))}
				</ul>
			)
		}
	</div>
</article>

<style>
	.news {
		max-width: 820px;
	}

	.news h1 {
		font-size: clamp(1.6rem, 2vw + 1rem, 2.25rem);
		text-transform: none;
	}

	.back {
		font-family: var(--font-heading);
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 1.25rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		margin-bottom: 2rem;
	}

	.hero-image {
		display: block;
		width: 100%;
		border-radius: var(--radius);
		margin-bottom: 2.5rem;
	}

	.prose {
		max-width: none;
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1rem;
		list-style: none;
		margin: 2.5rem 0 0;
		padding: 0;
	}

	.gallery img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius);
		display: block;
	}
</style>
