---
/** Compact page banner used by every page except the homepage. */
interface Props {
	title: string;
	subtitle?: string;
	eyebrow?: string;
}

const { title, subtitle, eyebrow } = Astro.props;
---

<section class="page-hero">
	<div class="container">
		{eyebrow && <span class="eyebrow eyebrow--light">{eyebrow}</span>}
		<h1>{title}</h1>
		{subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
	</div>
</section>

<style>
	.page-hero {
		background: linear-gradient(180deg, #5a5a5a 0%, #1c1c1c 100%);
		color: #fff;
		padding-block: clamp(3rem, 6vw, 4.5rem);
	}

	.page-hero h1 {
		color: #fff;
		margin-bottom: 0;
	}

	.eyebrow--light {
		color: rgba(255, 255, 255, 0.7);
	}

	.page-hero__subtitle {
		max-width: 68ch;
		margin: 1rem 0 0;
		color: rgba(255, 255, 255, 0.85);
	}
</style>
