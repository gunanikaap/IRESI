---
import { render, type CollectionEntry } from 'astro:content';
import PageHero from './PageHero.astro';

interface Props {
	topic: CollectionEntry<'research'>;
}

const { topic } = Astro.props;
const { Content } = await render(topic);
---

<article>
	<PageHero eyebrow="Research" title={topic.data.title} subtitle={topic.data.summary} />

	<section class="section">
		<div class="container">
			<div class="prose">
				<Content />
			</div>

			<ul class="related">
				<li><a href="/projects">See our projects &rsaquo;</a></li>
				<li><a href="/publications">See our publications &rsaquo;</a></li>
			</ul>
		</div>
	</section>
</article>

<style>
	.related {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		list-style: none;
		margin: 2.5rem 0 0;
		padding: 1.5rem 0 0;
		border-top: 1px solid var(--color-border);
		font-family: var(--font-heading);
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
</style>
