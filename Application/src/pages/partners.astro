---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const industryPartners = [
	['Three o’clock', '/images/partners/three-oclock.png'],
	['Artemat', '/images/partners/artemat.png'],
	['IKIM', '/images/partners/ikim.png'],
	['Finnova', '/images/partners/finnova.png'],
	['Global Hope Network International', '/images/partners/global-hope-network.jpeg'],
];

const researchPartners = [
	['Lero', '/images/partners/lero.png'],
	['COER', '/images/partners/coer.png'],
	['UCD Energy Institute', '/images/partners/ucd-energy-institute.jpg'],
	['MaREI', '/images/partners/marei.jpg'],
	['IVI', '/images/partners/ivi.png'],
	['University of Genoa', '/images/partners/university-of-genoa.jpeg'],
	['Halmstad University', '/images/partners/halmstad-university.png'],
	['UNITAR', '/images/partners/unitar.png'],
];
---

<BaseLayout
	title="Partners"
	description="IRESI collaborates with leading industry and research partners across Europe to advance sustainable energy innovation."
	image="/images/partners/lead.jpg"
>
	<PageHero title="Partners" subtitle="Empowering Sustainable Energy Together" />

	<section class="section">
		<div class="container intro-grid">
			<div>
				<p>
					At International Renewables and Energy Systems Integration (IRESI), we firmly believe that
					the path to a sustainable energy future is paved with strong partnerships. Our journey
					towards energy excellence is enriched by the collective wisdom, expertise, and commitment
					of our esteemed partners.
				</p>
				<h2>Collaboration for Impact</h2>
				<p>
					Our partners play a pivotal role in our mission to integrate and optimize energy systems
					for a cleaner and greener world. Together, we drive innovation, create real-world
					solutions, and make a lasting impact on our environment and society.
				</p>
			</div>
			<img src="/images/partners/lead.jpg" alt="" width="800" height="533" loading="lazy" />
		</div>
	</section>

	<section class="section section--alt">
		<div class="container">
			<h2>Our Industry Partners</h2>
			<ul class="logo-grid">
				{
					industryPartners.map(([name, logo]) => (
						<li>
							<img src={logo} alt={name} loading="lazy" />
						</li>
					))
				}
			</ul>

			<h2 class="section-heading">Our Research Partners</h2>
			<ul class="logo-grid">
				{
					researchPartners.map(([name, logo]) => (
						<li>
							<img src={logo} alt={name} loading="lazy" />
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section">
		<div class="container join">
			<h2>Join Our Network</h2>
			<p class="lead">
				If you share our passion for sustainable energy and want to make a difference, we invite you
				to explore partnership opportunities with IRESI. Together, we can shape the future of energy
				systems integration.
			</p>
			<a class="button" href="/contact">Get in touch</a>
		</div>
	</section>
</BaseLayout>

<style>
	.intro-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.intro-grid img {
		width: 100%;
		border-radius: var(--radius);
	}

	.intro-grid h2 {
		font-size: 1.25rem;
		margin-top: 1.75rem;
	}

	.logo-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 1.25rem;
		list-style: none;
		margin: 1.75rem 0 0;
		padding: 0;
	}

	.logo-grid li {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.logo-grid img {
		max-height: 70px;
		width: auto;
		object-fit: contain;
	}

	.section-heading {
		margin-top: 3rem;
	}

	.join {
		max-width: 68ch;
	}

	@media (max-width: 900px) {
		.intro-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
