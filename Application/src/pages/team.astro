---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
	title="Team"
	description="Meet the researchers, educators and innovators of the IRESI Centre at Maynooth University."
>
	<section class="section">
		<div class="container team-intro">
			<h1>Our Team</h1>
			<p class="lead">
				The International Research on Energy system integration, Education, and Environment for
				Sustainability and Innovation (IRESI) Centre brings together researchers, educators and
				innovators committed to advancing sustainable energy.
			</p>
			<p class="lead">
				As part of Maynooth University, our team combines diverse expertise to address complex
				energy challenges through interdisciplinary research, education and collaboration.
			</p>
		</div>
	</section>

	<section class="section section--alt">
		<div class="container">
			<ul class="team-grid">
				{
					members.map((member) => (
						<li class="member">
							<img
								class="member__photo"
								src={member.data.photo}
								alt={member.data.name}
								width="270"
								height="300"
								loading="lazy"
							/>
							<h2 class="member__name">{member.data.name}</h2>
							<p class="member__role">{member.data.role}</p>
							<ul class="member__links">
								{member.data.email && (
									<li>
										<a href={`mailto:${member.data.email}`} aria-label={`Email ${member.data.name}`}>
											<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
												<path
													fill="currentColor"
													d="M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 4.2l-8 5-8-5V6l8 5 8-5v2.2z"
												/>
											</svg>
										</a>
									</li>
								)}
								{member.data.linkedin && (
									<li>
										<a
											href={member.data.linkedin}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`${member.data.name} profile`}
										>
											<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
												<path
													fill="currentColor"
													d="M6.9 8.6H3.5v11h3.4v-11zM5.2 3.2a2 2 0 100 4 2 2 0 000-4zM20.5 13.5c0-3.2-1.7-4.7-4-4.7-1.8 0-2.7 1-3.1 1.7V8.6H10v11h3.4v-6.1c0-1.6.3-3.2 2.3-3.2s2 1.8 2 3.3v6h3.4v-6.1z"
												/>
											</svg>
										</a>
									</li>
								)}
							</ul>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.team-intro {
		max-width: 74ch;
	}

	.team-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
		gap: 1.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.member {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 1.5rem 1rem;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.member__photo {
		width: 100%;
		max-width: 190px;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		object-position: top center;
		border-radius: 50%;
		margin-bottom: 1.1rem;
	}

	.member__name {
		font-size: 0.9375rem;
		margin-bottom: 0.3rem;
	}

	.member__role {
		font-size: 0.8125rem;
		color: var(--color-text-muted);
		margin-bottom: 0.9rem;
	}

	.member__links {
		display: flex;
		gap: 0.5rem;
		list-style: none;
		margin: auto 0 0;
		padding: 0;
	}

	.member__links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		color: var(--color-text-muted);
		transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
	}

	.member__links a:hover {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: #fff;
	}
</style>
