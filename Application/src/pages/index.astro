---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// The homepage previews the first four projects; the rest live on /projects.
const featured = projects.slice(0, 4);

const stats = [
	{ value: '10+', label: 'International Projects' },
	{ value: '20+', label: 'Researchers & Experts' },
	{ value: '50+', label: 'Scientific Publications' },
	{ value: '10+', label: 'Partner Institutions' },
	{ value: 'Since 2020', label: 'EU-Funded' },
];

const focus = [
	{ title: 'Research Excellence', text: 'We lead research in renewable energy integration to build smarter systems.' },
	{ title: 'Collaborative Network', text: 'Connecting academia, industry, and policy to drive innovation.' },
	{ title: 'Real-World Impact', text: 'Delivering measurable change for a sustainable future.' },
	{ title: 'Innovation & Integration', text: 'Transforming research into practical energy solutions.' },
];

const collage = Array.from({ length: 9 }, (_, i) => `/images/home/collage-${i + 1}.jpg`);

const partnerLogos = [
	['Three o’clock', '/images/partners/three-oclock.png'],
	['Artemat', '/images/partners/artemat.png'],
	['IKIM', '/images/partners/ikim.png'],
	['Finnova', '/images/partners/finnova.png'],
	['Global Hope Network International', '/images/partners/global-hope-network.jpeg'],
	['Lero', '/images/partners/lero.png'],
	['COER', '/images/partners/coer.png'],
	['UCD Energy Institute', '/images/partners/ucd-energy-institute.jpg'],
	['MaREI', '/images/partners/marei.jpg'],
	['IVI', '/images/partners/ivi.png'],
	['University of Genoa', '/images/partners/university-of-genoa.jpeg'],
	['Halmstad University', '/images/partners/halmstad-university.png'],
	['UNITAR', '/images/partners/unitar.png'],
];
---

<BaseLayout description={site.shortDescription}>
	<section class="hero">
		<div class="container hero__inner">
			<h1>
				Driving the Future of Renewable Energy <span>Through Innovation &amp; Research</span>
			</h1>
			<p>
				We bring together researchers, institutions, and industries to advance sustainable energy
				systems and shape a cleaner future.
			</p>
			<div class="hero__actions">
				<a class="button" href="/projects">Explore Projects</a>
				<a class="button-outline" href="/about-us">Learn More</a>
			</div>
		</div>
	</section>

	<section class="section stats-section">
		<div class="container">
			<ul class="stats">
				{
					stats.map((stat) => (
						<li>
							<strong>{stat.value}</strong>
							<span>{stat.label}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section" id="aboutus">
		<div class="container about-grid">
			<div>
				<span class="eyebrow">About Us</span>
				<h2>Who We Are</h2>
				<p>
					The International Research on Energy system integration, Education, and Environment for
					Sustainability and Innovation (IRESI) Centre serves as a leading interdisciplinary hub at
					Maynooth University, dedicated to advancing sustainable, data-driven, and
					community-centred approaches to the clean energy transition.
				</p>
				<p>
					The mission of the IRESI Centre is to advance sustainable and data-driven solutions for
					decarbonisation, empowering learning, and fostering stakeholder engagement to accelerate
					progress towards achieving the SDGs by connecting technologies with communities, industry,
					and policymakers.
				</p>
				<a class="button" href="/about-us">Learn More</a>
			</div>
			<ul class="collage">
				{
					collage.map((src) => (
						<li>
							<img src={src} alt="" width="278" height="307" loading="lazy" />
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section section--alt">
		<div class="container focus-grid">
			<div class="focus-intro">
				<span class="eyebrow">Our Focus</span>
				<h2>We turn research into real-world energy solutions.</h2>
				<img src="/images/home/focus.png" alt="" width="600" height="396" loading="lazy" />
			</div>
			<ul class="focus-list">
				{
					focus.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section" id="projects">
		<div class="container">
			<span class="eyebrow">What We Worked On</span>
			<h2>Our Projects</h2>
			<ul class="project-grid">
				{featured.map((project) => <li><ProjectCard project={project} /></li>)}
			</ul>
			<p class="section-cta"><a class="button" href="/projects">See More</a></p>
		</div>
	</section>

	<section class="section section--alt" id="partners">
		<div class="container">
			<span class="eyebrow">Who We Work With</span>
			<h2>Partners &amp; Collaborations</h2>
			<p class="lead">
				We collaborate with leading research institutions and industry partners across Europe to
				advance sustainable energy innovation.
			</p>
			<ul class="logo-grid">
				{
					partnerLogos.map(([name, logo]) => (
						<li>
							<img src={logo} alt={name} loading="lazy" />
						</li>
					))
				}
			</ul>
			<p class="section-cta"><a class="button" href="/contact">Join Our Network</a></p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="eyebrow">Our Latest Findings</span>
			<h2>Publications &amp; Research Outputs</h2>
			<p class="lead">
				We share research outcomes through publications, reports, and case studies focused on
				renewable energy and system integration.
			</p>
			<p class="section-cta section-cta--left">
				<a class="button" href="/publications">View All</a>
			</p>
		</div>
	</section>

	<section class="cta-band">
		<div class="container">
			<h2>Join Us in Building a Sustainable Energy Future</h2>
			<p>
				We collaborate with researchers, industry partners, and institutions across Europe to drive
				innovation and positive energy transformation.
			</p>
			<a class="button-outline" href="/contact">Get In Touch</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		display: flex;
		align-items: center;
		min-height: min(90vh, 760px);
		color: #fff;
		background-image:
			linear-gradient(180deg, rgba(90, 90, 90, 0.5) 0%, rgba(28, 28, 28, 0.85) 100%),
			url('/images/home/hero.jpg');
		background-size: cover;
		background-position: center;
		padding-block: 5rem;
	}

	.hero__inner {
		max-width: 900px;
	}

	.hero h1 {
		color: #fff;
		max-width: 18ch;
	}

	/* Matches the live site, where the second half of the headline is greyed. */
	.hero h1 span {
		color: #bcbcbc;
	}

	.hero p {
		max-width: 56ch;
		font-size: 1.0625rem;
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: 2rem;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	/* --- Stats --- */

	.stats-section {
		padding-block: 3rem;
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.stats li {
		text-align: center;
		padding: 1.5rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.stats strong {
		display: block;
		font-family: var(--font-heading);
		font-size: 1.75rem;
		font-weight: 600;
		color: var(--color-accent);
		line-height: 1.2;
	}

	.stats span {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	/* --- About --- */

	.about-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.collage {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.collage img {
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: 6px;
		display: block;
	}

	/* --- Focus --- */

	.focus-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.focus-intro img {
		width: 100%;
		border-radius: var(--radius);
		margin-top: 1.5rem;
	}

	.focus-list {
		display: grid;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.focus-list li {
		padding: 1.5rem;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.focus-list h3 {
		margin-bottom: 0.5rem;
	}

	.focus-list p {
		margin: 0;
		color: var(--color-text-muted);
	}

	/* --- Projects --- */

	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 1.75rem;
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
	}

	.section-cta {
		margin-top: 2.5rem;
		text-align: center;
	}

	.section-cta--left {
		text-align: left;
	}

	/* --- Partner logos --- */

	.logo-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 1.25rem;
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
	}

	.logo-grid li {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.25rem;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.logo-grid img {
		max-height: 64px;
		width: auto;
		object-fit: contain;
	}

	/* --- Closing CTA --- */

	.cta-band {
		background: linear-gradient(180deg, #5a5a5a 0%, #1c1c1c 100%);
		color: #fff;
		text-align: center;
		padding-block: var(--section-gap);
	}

	.cta-band h2 {
		color: #fff;
	}

	.cta-band p {
		max-width: 62ch;
		margin: 0 auto 2rem;
		color: rgba(255, 255, 255, 0.85);
	}

	@media (max-width: 900px) {
		.about-grid,
		.focus-grid {
			grid-template-columns: 1fr;
		}

		.stats {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.stats {
			grid-template-columns: 1fr;
		}
	}
</style>
