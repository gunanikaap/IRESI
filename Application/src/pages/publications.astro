---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const researchers = (await getCollection('researchers')).sort((a, b) => a.data.order - b.data.order);
const publications = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);

// Render each researcher's markdown intro once, then attach their papers.
const groups = await Promise.all(
	researchers.map(async (researcher) => ({
		researcher,
		Bio: (await render(researcher)).Content,
		papers: publications.filter((p) => p.data.researcher.id === researcher.id),
	}))
);
---

<BaseLayout
	title="Publications"
	description="Academic publications, reports and collaborative research outputs from the IRESI Centre."
>
	<PageHero
		eyebrow="Horizon Europe"
		title="Publications & Research Outputs"
		subtitle="Explore our academic publications, reports, and collaborative research outputs contributing to the clean energy transition."
	/>

	{
		groups.map(({ researcher, Bio, papers }, index) => (
			<section class:list={['section', index % 2 === 1 && 'section--alt']}>
				<div class="container">
					<div class="researcher">
						<img
							class="researcher__photo"
							src={researcher.data.photo}
							alt={researcher.data.name}
							width="300"
							height="286"
							loading="lazy"
						/>
						<div class="researcher__body">
							<h2>{researcher.data.name}</h2>
							<p class="researcher__title">{researcher.data.title}</p>
							<div class="researcher__bio">
								<Bio />
							</div>
							<a
								class="button"
								href={researcher.data.profileUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								View All
							</a>
						</div>
					</div>

					<ul class="publications">
						{papers.map((paper) => (
							<li class="publication">
								<h3>{paper.data.title}</h3>
								<dl class="publication__meta">
									<div>
										<dt>Authors</dt>
										<dd>{paper.data.authors.join(', ')}</dd>
									</div>
									<div>
										<dt>Publication date</dt>
										<dd>{paper.data.date}</dd>
									</div>
									{paper.data.journal && (
										<div>
											<dt>Journal</dt>
											<dd>{paper.data.journal}</dd>
										</div>
									)}
									{paper.data.volume && (
										<div>
											<dt>Volume</dt>
											<dd>{paper.data.volume}</dd>
										</div>
									)}
									{paper.data.pages && (
										<div>
											<dt>Pages</dt>
											<dd>{paper.data.pages}</dd>
										</div>
									)}
									{paper.data.publisher && (
										<div>
											<dt>Publisher</dt>
											<dd>{paper.data.publisher}</dd>
										</div>
									)}
								</dl>
								{paper.data.description && (
									<p class="publication__description">{paper.data.description}</p>
								)}
								{paper.data.link && (
									<a
										class="publication__link"
										href={paper.data.link}
										target="_blank"
										rel="noopener noreferrer"
									>
										Read &rsaquo;
									</a>
								)}
							</li>
						))}
					</ul>
				</div>
			</section>
		))
	}
</BaseLayout>

<style>
	.researcher {
		display: grid;
		grid-template-columns: 300px 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.researcher__photo {
		width: 100%;
		border-radius: var(--radius);
	}

	.researcher h2 {
		margin-bottom: 0.5rem;
	}

	.researcher__title {
		font-family: var(--font-heading);
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-accent);
		margin-bottom: 1rem;
	}

	.researcher__bio {
		max-width: 68ch;
		color: var(--color-text-muted);
		margin-bottom: 1.5rem;
	}

	.publications {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 1.5rem;
		list-style: none;
		margin: 2.5rem 0 0;
		padding: 0;
	}

	.publication {
		display: flex;
		flex-direction: column;
		padding: 1.6rem;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.publication h3 {
		font-size: 1rem;
		text-transform: none;
		margin-bottom: 1rem;
	}

	.publication__meta {
		margin: 0 0 1rem;
		font-size: 0.875rem;
	}

	.publication__meta div {
		display: flex;
		gap: 0.4rem;
		margin-bottom: 0.3rem;
	}

	.publication__meta dt {
		flex-shrink: 0;
		font-weight: 600;
		color: var(--color-heading);
	}

	.publication__meta dt::after {
		content: ':';
	}

	.publication__meta dd {
		margin: 0;
		color: var(--color-text-muted);
	}

	.publication__description {
		font-size: 0.875rem;
		color: var(--color-text-muted);
		margin-bottom: 1rem;
	}

	.publication__link {
		margin-top: auto;
		font-family: var(--font-heading);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	@media (max-width: 780px) {
		.researcher {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.researcher__photo {
			max-width: 260px;
		}
	}
</style>
