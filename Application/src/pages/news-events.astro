---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const posts = (await getCollection('news'))
	.filter((post) => !post.data.unlisted)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormat = new Intl.DateTimeFormat('en-IE', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

// Project social accounts listed at the foot of the live News & Events page.
const projectFeeds = [
	{ name: 'RENEW', handle: '@RENEWchallenge', href: 'https://twitter.com/RENEWchallenge' },
	{ name: 'FLOW', handle: '@FLOW_V2X', href: 'https://twitter.com/FLOW_V2X' },
	{ name: 'NexSys', handle: '@NexSysEnergy', href: 'https://twitter.com/NexSysEnergy' },
	{ name: 'RES4CITY', handle: '@res4city', href: 'https://twitter.com/res4city' },
];
---

<BaseLayout
	title="News & Events"
	description="News, events and highlights from the IRESI Centre at Maynooth University."
>
	<PageHero title="News & Events" />

	<section class="section">
		<div class="container">
			<ul class="post-grid">
				{
					posts.map((post) => (
						<li class="post">
							<a class="post__link" href={`/${post.id}`}>
								{post.data.image && (
									<img
										class="post__image"
										src={post.data.image}
										alt=""
										width="480"
										height="300"
										loading="lazy"
									/>
								)}
								<div class="post__body">
									<h2>{post.data.title}</h2>
									<p>{post.data.summary}</p>
									<div class="post__footer">
										<time datetime={post.data.date.toISOString()}>
											{dateFormat.format(post.data.date)}
										</time>
										<span class="post__cta">Read More &raquo;</span>
									</div>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section section--alt">
		<div class="container">
			<h2>Follow our projects</h2>
			<ul class="feeds">
				{
					projectFeeds.map((feed) => (
						<li>
							<strong>{feed.name}</strong>
							<a href={feed.href} target="_blank" rel="noopener noreferrer">
								{feed.handle}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.post-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post {
		height: 100%;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		overflow: hidden;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.post:hover {
		transform: translateY(-3px);
		box-shadow: 0 16px 32px rgba(20, 30, 60, 0.12);
	}

	.post__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	.post__link:hover {
		text-decoration: none;
	}

	.post__image {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		display: block;
	}

	.post__body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1.4rem;
	}

	.post__body h2 {
		font-size: 1rem;
		text-transform: none;
		margin-bottom: 0.6rem;
	}

	.post__body p {
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		margin-bottom: 1.2rem;
	}

	.post__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: auto;
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.post__cta {
		font-family: var(--font-heading);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.feeds {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1rem;
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
	}

	.feeds li {
		padding: 1.2rem 1.35rem;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.feeds strong {
		display: block;
		font-family: var(--font-heading);
		font-size: 0.875rem;
		text-transform: uppercase;
		margin-bottom: 0.35rem;
	}
</style>
