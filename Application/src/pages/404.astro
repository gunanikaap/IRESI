---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
	<section class="section not-found">
		<div class="container">
			<p class="code">404</p>
			<h1>Page not found</h1>
			<p class="lead">
				The page you were looking for may have moved or no longer exists. Try one of the links
				below, or <a href="/contact">get in touch</a>.
			</p>
			<ul class="links">
				<li><a class="button" href="/">Home</a></li>
				<li><a class="button-outline button-outline--dark" href="/projects">Projects</a></li>
				<li><a class="button-outline button-outline--dark" href="/publications">Publications</a></li>
				<li><a class="button-outline button-outline--dark" href="/news-events">News &amp; Events</a></li>
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.not-found {
		padding-block: clamp(4rem, 10vw, 7rem);
	}

	.code {
		font-family: var(--font-heading);
		font-size: 3rem;
		font-weight: 700;
		color: var(--color-accent);
		margin-bottom: 0.5rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
	}
</style>
