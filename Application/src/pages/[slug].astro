---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectArticle from '../components/ProjectArticle.astro';
import ResearchArticle from '../components/ResearchArticle.astro';
import NewsArticle from '../components/NewsArticle.astro';

/**
 * Projects, research topics and news posts all lived at the root of the old
 * WordPress site (/renew/, /renewables/, /celebrating-science-night.../). This
 * single route reproduces those URLs so inbound links keep working.
 */
type Props =
	| { type: 'project'; project: CollectionEntry<'projects'> }
	| { type: 'research'; topic: CollectionEntry<'research'> }
	| { type: 'news'; post: CollectionEntry<'news'> };

export const getStaticPaths: GetStaticPaths = async () => {
	const [projects, research, news] = await Promise.all([
		getCollection('projects'),
		getCollection('research'),
		getCollection('news'),
	]);

	return [
		// Projects that only link out (LERO, CO-CREATIVE LAB) get no page.
		...projects
			.filter((project) => !project.data.externalOnly)
			.map((project) => ({
				params: { slug: project.id },
				props: { type: 'project' as const, project },
			})),
		...research.map((topic) => ({
			params: { slug: topic.id },
			props: { type: 'research' as const, topic },
		})),
		...news.map((post) => ({
			params: { slug: post.id },
			props: { type: 'news' as const, post },
		})),
	];
};

const props = Astro.props as Props;

const meta =
	props.type === 'project'
		? {
				title: props.project.data.title,
				description: props.project.data.summary,
				image: props.project.data.image ?? props.project.data.cardImage,
			}
		: props.type === 'research'
			? { title: props.topic.data.title, description: props.topic.data.summary, image: undefined }
			: {
					title: props.post.data.title,
					description: props.post.data.summary,
					image: props.post.data.image,
				};
---

<BaseLayout title={meta.title} description={meta.description} image={meta.image}>
	{props.type === 'project' && <ProjectArticle project={props.project} />}
	{props.type === 'research' && <ResearchArticle topic={props.topic} />}
	{props.type === 'news' && <NewsArticle post={props.post} />}
</BaseLayout>
