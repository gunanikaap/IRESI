---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

/**
 * Redirect stubs for WordPress URLs that no longer have a page of their own.
 * They emit a canonical link plus a meta refresh, which works on any plain
 * static host (no server-side redirect rules required).
 *
 * Astro hoists `getStaticPaths` into its own module, so everything it needs
 * has to be declared inside it.
 */
export const getStaticPaths: GetStaticPaths = async () => {
	const STATIC_REDIRECTS: Record<string, string> = {
		// The old menu had both /about/ and /about-us/ pointing at the same page.
		about: '/about-us',
		// WordPress named the research hub "research-2" to avoid a slug clash.
		'research-2': '/research',
		// Footer menus linked to /people/ in places.
		people: '/team',
	};

	const news = await getCollection('news');

	const fromNews = news.flatMap((post) =>
		post.data.legacyPaths.map((legacyPath) => ({
			params: { legacy: legacyPath.replace(/^\/+|\/+$/g, '') },
			props: { target: `/${post.id}` },
		}))
	);

	const fromStatic = Object.entries(STATIC_REDIRECTS).map(([from, target]) => ({
		params: { legacy: from },
		props: { target },
	}));

	return [...fromNews, ...fromStatic];
};

const { target } = Astro.props as { target: string };
const destination = new URL(target, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Redirecting…</title>
		<link rel="canonical" href={destination} />
		<meta name="robots" content="noindex" />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
	</head>
	<body>
		<p>This page has moved. <a href={target}>Continue to {target}</a>.</p>
		<script is:inline define:vars={{ target }}>
			window.location.replace(target);
		</script>
	</body>
</html>
