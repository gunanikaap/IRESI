{
  "name": "iresi-platform",
  "version": "0.1.0",
  "private": true,
  "description": "IRESI website platform — shared core with per-project configuration",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run build && npm run typecheck",
    "db:setup": "node scripts/db-setup.mjs",
    "db:user": "node scripts/db-user.mjs",
    "db:seed": "node scripts/seed-content.mjs"
  },
  "dependencies": {
    "next": "16.2.12",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "typescript": "^5"
  }
}
